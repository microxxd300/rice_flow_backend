# Copy to .env.docker for `docker compose up`. Never commit .env.docker.

# Django
SECRET_KEY=generate-with-python-secrets-token-urlsafe-50
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# The local stack serves plain http, so turn off the HTTPS-only production settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# PostgreSQL container. DATABASE_URL must use the same user, password, and db name.
POSTGRES_DB=riceflow
POSTGRES_USER=riceflow
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://riceflow:change-me@db:5432/riceflow

# External services (optional for a local run)
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PANABO_LAT=7.3086
PANABO_LON=125.6830
