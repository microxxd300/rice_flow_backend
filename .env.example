SECRET_KEY=your-django-secret-key-here
# True for local development only. Production must use False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated https origins, e.g. https://riceflow-api.onrender.com
CSRF_TRUSTED_ORIGINS=

# Django admin path; must start with admin/ and end with /. Use a hard-to-guess one in production.
DJANGO_ADMIN_URL=admin/
# Browser origins allowed to call the API (comma-separated). Empty or unset = local dev origins.
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# Supabase PostgreSQL connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional: Redis cache. Leave empty to use the in-memory cache
# (docker-compose.yml sets this to the Redis container).
REDIS_URL=

# Number of proxies in front of Django (nginx, Render, ngrok); used to find the client IP
# for rate limiting. 1 fits all current setups.
NUM_PROXIES=1

# Supabase API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Panabo City fixed coordinates
PANABO_LAT=7.3086
PANABO_LON=125.6830

# Gemini AI — get a free key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
# AI chat answers per farmer per day (Gemini free tier is shared by the whole app)
# AI_CHAT_DAILY_LIMIT=15

# Path to the DA harvest-report CSV for the yield model (not in git); empty = synthetic data
YIELD_TRAINING_CSV=
