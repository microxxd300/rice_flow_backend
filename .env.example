SECRET_KEY=your-django-secret-key-here
# True for local development only. Production must use False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated https origins, e.g. https://riceflow-api.onrender.com
CSRF_TRUSTED_ORIGINS=

# Supabase PostgreSQL connection
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Panabo City fixed coordinates
PANABO_LAT=7.3086
PANABO_LON=125.6830

# Gemini AI — get a free key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
