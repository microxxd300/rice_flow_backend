# Copy to /opt/riceflow/.env.prod on the VM and fill in every <...>. Never commit .env.prod.

# Django
SECRET_KEY=<a long random string: python -c "import secrets; print(secrets.token_urlsafe(50))">
DEBUG=False
ALLOWED_HOSTS=api.riceflow.me
CSRF_TRUSTED_ORIGINS=https://api.riceflow.me,https://admin.riceflow.me
# Browser sites that may call the API (the mobile app does not need this)
CORS_ALLOWED_ORIGINS=https://admin.riceflow.me,https://riceflow.me
# Django's own admin page; use a hard-to-guess path (must start with admin/ and end with /)
DJANGO_ADMIN_URL=admin/<something-hard-to-guess>/
# Caddy in front of Django
NUM_PROXIES=1
GUNICORN_WORKERS=2

# PostgreSQL (DATABASE_URL must match the three lines above it)
POSTGRES_DB=riceflow
POSTGRES_USER=riceflow
POSTGRES_PASSWORD=<a long random password>
DATABASE_URL=postgres://riceflow:<the same password>@db:5432/riceflow

# GeoRice AI (Gemini, free tier) and its booklet search
GEMINI_API_KEY=<your Gemini key>
GEMINI_FILE_SEARCH_STORE=fileSearchStores/riceflowbooklets-h2eotx1mjxdm
AI_CHAT_DAILY_LIMIT=15

# Panabo City
PANABO_LAT=7.3086
PANABO_LON=125.6830

# Forgot-password emails go out through Resend from noreply@riceflow.me. Key: resend.com, Sending access.
RESEND_API_KEY=
